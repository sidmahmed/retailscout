{
  "openapi": "3.1.0",
  "info": {
    "title": "RetailScout API",
    "description": "RetailScout runtime API. Serves precomputed location scores and evidence for the City of Melbourne. Data: City of Melbourne Open Data (attribution required \u2014 see /api/v1/data-sources when built).",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "description": "Liveness probe. Deliberately does not touch the database \u2014\na database outage must degrade features, not report the API dead.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/locations/score": {
      "get": {
        "tags": [
          "locations"
        ],
        "summary": "Get Location Score",
        "description": "Score a candidate point: point -> containing analysis cell ->\nprecomputed score row. No spatial computation beyond containment.",
        "operationId": "get_location_score_api_v1_locations_score_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90,
              "minimum": -90,
              "description": "WGS84 latitude",
              "title": "Lat"
            },
            "description": "WGS84 latitude"
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180,
              "minimum": -180,
              "description": "WGS84 longitude",
              "title": "Lon"
            },
            "description": "WGS84 longitude"
          },
          {
            "name": "profile",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/BusinessProfile"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreResponse"
                }
              }
            }
          },
          "400": {
            "description": "Point outside the supported municipal boundary (FR-02)"
          },
          "503": {
            "description": "No published data release / scores yet"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/business-profiles": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Get Business Profiles",
        "operationId": "get_business_profiles_api_v1_business_profiles_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProfileInfo"
                  },
                  "type": "array",
                  "title": "Response Get Business Profiles Api V1 Business Profiles Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/coverage": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Get Coverage",
        "operationId": "get_coverage_api_v1_coverage_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Coverage"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tiles/suitability/{profile}/{z}/{x}/{y}.mvt": {
      "get": {
        "tags": [
          "tiles"
        ],
        "summary": "Get Suitability Tile",
        "operationId": "get_suitability_tile_api_v1_tiles_suitability__profile___z___x___y__mvt_get",
        "parameters": [
          {
            "name": "profile",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/BusinessProfile"
            }
          },
          {
            "name": "z",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 22,
              "minimum": 0,
              "title": "Z"
            }
          },
          {
            "name": "x",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "title": "X"
            }
          },
          {
            "name": "y",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "title": "Y"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/vnd.mapbox-vector-tile": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BusinessProfile": {
        "type": "string",
        "enum": [
          "cafe",
          "retail_shop",
          "food_truck",
          "pop_up"
        ],
        "title": "BusinessProfile"
      },
      "ComponentScore": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key",
            "description": "e.g. pedestrian_demand, worker_demand, market_fit"
          },
          "score": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Score",
            "description": "Null when the component was not computed (missing evidence, reweighted out per \u00a715.5) \u2014 never coerced to 0."
          },
          "weight": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Weight"
          },
          "evidence": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Evidence",
            "description": "Raw supporting values and percentiles; nulls mean 'not observed'"
          }
        },
        "type": "object",
        "required": [
          "key",
          "weight"
        ],
        "title": "ComponentScore"
      },
      "Confidence": {
        "properties": {
          "score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "band": {
            "$ref": "#/components/schemas/ConfidenceBand"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons",
            "description": "Human-readable evidence, e.g. 'Nearest sensor is 430 m away'"
          }
        },
        "type": "object",
        "required": [
          "score",
          "band",
          "reasons"
        ],
        "title": "Confidence",
        "description": "Shown separately from suitability \u2014 never blended invisibly."
      },
      "ConfidenceBand": {
        "type": "string",
        "enum": [
          "high",
          "medium",
          "low",
          "insufficient"
        ],
        "title": "ConfidenceBand"
      },
      "Coverage": {
        "properties": {
          "municipality": {
            "type": "string",
            "title": "Municipality",
            "default": "City of Melbourne"
          },
          "data_release": {
            "type": "string",
            "title": "Data Release"
          },
          "boundary": {
            "additionalProperties": true,
            "type": "object",
            "title": "Boundary",
            "description": "GeoJSON MultiPolygon, simplified"
          },
          "bounds": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Bounds",
            "description": "[min_lon, min_lat, max_lon, max_lat]"
          }
        },
        "type": "object",
        "required": [
          "data_release",
          "boundary",
          "bounds"
        ],
        "title": "Coverage"
      },
      "DaypartEstimate": {
        "properties": {
          "day_type": {
            "type": "string",
            "title": "Day Type",
            "description": "e.g. weekday, saturday, sunday"
          },
          "daypart": {
            "type": "string",
            "title": "Daypart",
            "description": "e.g. morning, lunch, afternoon, evening"
          },
          "pedestrian_estimate": {
            "type": "number",
            "minimum": 0.0,
            "title": "Pedestrian Estimate",
            "description": "Distance-decay estimate of pedestrians per hour; not observed storefront footfall."
          },
          "confidence": {
            "$ref": "#/components/schemas/ConfidenceBand"
          },
          "n_sensors": {
            "type": "integer",
            "minimum": 1.0,
            "title": "N Sensors"
          },
          "nearest_sensor_m": {
            "type": "number",
            "minimum": 0.0,
            "title": "Nearest Sensor M"
          }
        },
        "type": "object",
        "required": [
          "day_type",
          "daypart",
          "pedestrian_estimate",
          "confidence",
          "n_sensors",
          "nearest_sensor_m"
        ],
        "title": "DaypartEstimate",
        "description": "Modelled pedestrian activity for one local day-type/daypart slot."
      },
      "DaypartFootTraffic": {
        "properties": {
          "baseline_version": {
            "type": "string",
            "title": "Baseline Version"
          },
          "estimates": {
            "items": {
              "$ref": "#/components/schemas/DaypartEstimate"
            },
            "type": "array",
            "title": "Estimates"
          }
        },
        "type": "object",
        "required": [
          "baseline_version",
          "estimates"
        ],
        "title": "DaypartFootTraffic",
        "description": "Config-driven daypart series used by the score's pedestrian evidence."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse"
      },
      "ProfileInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "description"
        ],
        "title": "ProfileInfo"
      },
      "ScoreLocation": {
        "properties": {
          "lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon"
          },
          "cell_id": {
            "type": "string",
            "title": "Cell Id"
          }
        },
        "type": "object",
        "required": [
          "lat",
          "lon",
          "cell_id"
        ],
        "title": "ScoreLocation"
      },
      "ScoreResponse": {
        "properties": {
          "location": {
            "$ref": "#/components/schemas/ScoreLocation"
          },
          "profile": {
            "$ref": "#/components/schemas/BusinessProfile"
          },
          "score": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Score",
            "description": "Overall suitability. Null when critical evidence is missing \u2014 a withheld score is a valid product outcome, not an error."
          },
          "confidence": {
            "$ref": "#/components/schemas/Confidence"
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/ComponentScore"
            },
            "type": "array",
            "title": "Components"
          },
          "top_drivers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Top Drivers"
          },
          "top_risks": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Top Risks"
          },
          "daypart_foot_traffic": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DaypartFootTraffic"
              },
              {
                "type": "null"
              }
            ],
            "description": "Modelled hourly pedestrian estimates. Null when no sensor is within interpolation range."
          },
          "score_version": {
            "type": "string",
            "title": "Score Version",
            "description": "e.g. cafe-v1.0.0"
          },
          "data_release": {
            "type": "string",
            "title": "Data Release",
            "description": "e.g. melbourne-2026-07-25"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          }
        },
        "type": "object",
        "required": [
          "location",
          "profile",
          "confidence",
          "components",
          "daypart_foot_traffic",
          "score_version",
          "data_release",
          "generated_at"
        ],
        "title": "ScoreResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}

# Copy to .env and adjust. Never commit .env.
#
# Two database URLs on purpose (see database-architecture.md):
#  - DATABASE_URL        pooled (Supabase Supavisor :6543) — runtime API only
#  - DATABASE_DIRECT_URL direct (:5432) — Alembic migrations, bulk jobs, DDL
# Locally both point at the same Docker Compose PostGIS.

DATABASE_URL=postgresql+psycopg://retailscout:local-development-only@localhost:5432/retailscout
DATABASE_DIRECT_URL=postgresql+psycopg://retailscout:local-development-only@localhost:5432/retailscout

# Where ingestion jobs write immutable raw snapshots locally.
# In deployed environments this is replaced by S3-compatible object storage.
RAW_DATA_DIR=../data/raw

# City of Melbourne Open Data (OpenDataSoft Explore v2.1). No API key
# required for public datasets at current volumes.
COM_OPEN_DATA_BASE_URL=https://data.melbourne.vic.gov.au/api/explore/v2.1

# Frontend → API base (same-domain /api/v1 in production on Vercel)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Explicit-submit address search. Public Nominatim permits moderate,
# end-user-triggered searches only (no autocomplete; max 1 request/sec).
# Point this at a compatible hosted/self-hosted provider before scaling.
NEXT_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org/search
